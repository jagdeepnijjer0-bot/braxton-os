# Supabase — get from https://app.supabase.com → project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — get from https://dashboard.stripe.com → Developers → API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs (from Stripe Dashboard → Products)
EXPO_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_your_premium_price_id
EXPO_PUBLIC_MEMBERSHIP_PRICE_DISPLAY=£24.00 / month

# Restaurant contact details
EXPO_PUBLIC_RESTAURANT_EMAIL=info@cafelocco.co.uk
EXPO_PUBLIC_RESTAURANT_PHONE=024 7704 9561
EXPO_PUBLIC_RESTAURANT_WHATSAPP=
EXPO_PUBLIC_RESTAURANT_ADDRESS=139 Daventry Rd, Coventry CV3 5HD

# Social media (full URLs)
EXPO_PUBLIC_RESTAURANT_INSTAGRAM=https://instagram.com/cafelocco
EXPO_PUBLIC_RESTAURANT_TIKTOK=https://tiktok.com/@cafelocco
EXPO_PUBLIC_RESTAURANT_FACEBOOK=https://facebook.com/cafelocco

# Hero section customisation (optional — leave blank to hide tagline)
# EXPO_PUBLIC_HERO_IMAGE_URL=https://your-cdn.com/hero.jpg
# EXPO_PUBLIC_RESTAURANT_TAGLINE=FINE DINING · COVENTRY
# EXPO_PUBLIC_RESTAURANT_SUBTITLE=Where every dish tells a story.

# Opening hours — use 'Closed' for days the restaurant is shut
EXPO_PUBLIC_HOURS_MON=9am – 8pm
EXPO_PUBLIC_HOURS_TUE=9am – 8pm
EXPO_PUBLIC_HOURS_WED=9am – 8pm
EXPO_PUBLIC_HOURS_THU=9am – 8pm
EXPO_PUBLIC_HOURS_FRI=9am – 8pm
EXPO_PUBLIC_HOURS_SAT=9am – 8pm
EXPO_PUBLIC_HOURS_SUN=9am – 8pm
